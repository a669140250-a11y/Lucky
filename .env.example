# 选择后端 / Choose backend: claude | grok | muse | openai
AGENT_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Grok (xAI, OpenAI-compatible)
XAI_API_KEY=
# GROK_MODEL=grok-4

# Muse 或任意 OpenAI 兼容接口 / Muse or any OpenAI-compatible endpoint
MUSE_API_KEY=
MUSE_BASE_URL=
MUSE_MODEL=

# Generic OpenAI-compatible
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 可选 / Optional
# SYSTEM_PROMPT=你是一个乐于助人的微信助手，回答简洁。
# HISTORY_TURNS=20
# ALLOW_USERS=wxid_a@im.wechat,wxid_b@im.wechat
# STATE_DIR=~/.wechat-agent
